  "douyin.com": {
    "Front Page": {
      "https://www.douyin.com/discover": {
        "expected": [20, 60],
        "more-after-scroll": true,
        "wait": 10,
        "comment": "Douyin loves captchas; longer wait is needed until for them to load. Redirects to /jingxuan. Serves 50 to a logged-out visitor and about 90 after scrolling, but loads them in batches of 20 so a slow load lands lower.",
        "captcha-selector": "div#captcha_container"
      }
    },
    "Recommended": {
      "https://www.douyin.com/": {
        "expected": [20, 60],
        "more-after-scroll": true,
        "wait": 10,
        "comment": "Only one of the several aweme_list objects this page loads is visible, so the count is far below the number of videos in the responses.",
        "captcha-selector": "div#captcha_container"
      }
    },
    "User page": {
      "https://www.douyin.com/user/MS4wLjABAAAAqtpQNZmjRtGJdpyk0gbAh6OpqqBjJddNTgLhmK3Y0CI": {
