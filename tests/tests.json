        "more-after-scroll": false,
        "wait": 10,
        "captcha-selector": "div#captcha_container"
      }
    },
    "Search": {
      "https://www.douyin.com/search/%E6%90%9E%E7%AC%91": {
        "expected": 26,
        "more-after-scroll": true,
        "wait": 10,
