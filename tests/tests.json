    "Hot": {
      "https://www.douyin.com/hot": {
        "expected": [8, 30],
        "more-after-scroll": true,
        "wait": 10,
        "comment": "Starts with a short list, around 10, and reaches 40 to 50 after scrolling.",
        "captcha-selector": "div#captcha_container"
      }
    },
    "Channels": {
      "https://www.douyin.com/channel/300205": {
        "expected": [20, 60],
        "more-after-scroll": true,
        "wait": 10,
        "comment": "Redirects to /jingxuan/game. Same batching as the front page.",
        "captcha-selector": "div#captcha_container"
      }
    },
    "Individual post page": {
      "https://www.douyin.com/?modal_id=7092325988377316616": {
        "expected": 1,
        "more-after-scroll": false,
        "wait": 10,
        "comment": "Douyin loads full background page (i.e. www.douyin.com) and then individual post in popup. The post itself is embedded in the page under app.videoDetail rather than fetched; the recommendations behind the popup are deliberately not collected.",
